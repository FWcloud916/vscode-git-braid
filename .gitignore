# Rust
/target/
Cargo.lock       # library; lock file intentionally excluded (extension bundle controls versions)

# Node / pnpm
node_modules/
dist/
*.tsbuildinfo

# Native addon binaries (platform-specific .node files — never commit)
*.node
# index.js and index.d.ts are *not* excluded: napi-rs projects commit
# these JS/TS interface files as stubs that `napi build` overwrites.
# Only the binary .node files are generated artefacts to exclude.

# VS Code Extension
*.vsix
.vscode-test/

# macOS
.DS_Store
**/.DS_Store

# Editor
.idea/
*.swp
*.swo

# Benchmarks
/criterion/
